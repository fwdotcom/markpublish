# Byte-compiled / optimized files
__pycache__/
*.py[cod]

# Virtual environment
.venv/
venv/

# Build & packaging
build/
dist/
*.egg-info/

# Testing & quality tools
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Local editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Interne Arbeitsunterlagen - Architekturnotizen und Code-Reviews. Sie bleiben
# lokal liegen und gehoeren nicht in die Veroeffentlichung.
/docs/

# Scratch & debug artifacts
scratch/
.markpublish/
*.pdf

# Die ausgelieferten Handbuecher gehoeren dazu: sie sind das Ergebnis, an dem
# eine Aenderung am Satz zuerst auffaellt, und sollen im Repository stehen.
!manual/*.pdf
