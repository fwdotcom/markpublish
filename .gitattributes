# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit binary files
*.ttf binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.conf text eol=lf
*.txt text eol=lf

